@model OrchardCore.ContentFields.ViewModels.EditDateTimeFieldViewModel
@using OrchardCore
@using OrchardCore.ContentFields.Settings
@using OrchardCore.ContentManagement.Metadata.Models
@{
    var settings = Model.PartFieldDefinition.GetSettings<DateTimeFieldSettings>();
}
<script asp-name="jQuery-ui-i18n" at="Foot"></script>
<div class="ocat-wrapper @Model.PartFieldDefinition" id="@Html.IdFor(x => x.LocalDateTime)_FieldWrapper">
    <label class="@Orchard.GetLabelClasses(settings)">@Model.PartFieldDefinition.DisplayName()</label>
    <div class="ocat-end">
        <div class="ocat-limited-wrapper">
            <div class="ocat-limited">
                <input hidden asp-for="LocalDateTime" />
                <strong>@(Model.LocalDateTime.HasValue ? Model.LocalDateTime.Value : T["Not set."])</strong>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(settings.Hint))
        {
            <span class="hint">@settings.Hint</span>
        }
    </div>
</div>
