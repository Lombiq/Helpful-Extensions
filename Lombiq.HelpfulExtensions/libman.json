{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "defaultDestination": "wwwroot/vendors/[Name]",
  "libraries": [
    {
      "library": "prismjs@1.30.0"
    },
    {
      "library": "trumbowyg@2.31.0",
      "files": [
        "dist/**/*",
        "plugins/**/*"
      ]
    },
    {
      "library": "lucide@1.14.0",
      "files": [
        "dist/umd/lucide.js",
        "dist/umd/lucide.min.js"
      ]
    },
    {
      "library": "simple-icons@16.19.0",
      "files": [
        "icons/*.svg"
      ]
    }
  ]
}