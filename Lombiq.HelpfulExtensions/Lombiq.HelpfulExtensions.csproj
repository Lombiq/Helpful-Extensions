<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Lombiq.MSBuild.OrchardCore.Module.Sdk" Version="2.0.1" />

  <PropertyGroup>
    <Title>Lombiq Helpful Extensions for Orchard Core</Title>
    <CopyrightYear>2013</CopyrightYear>
    <DescriptionBody>Orchard Core module containing some handy extensions (e.g. useful content types and widgets). It's also available on all sites of DotNest, the Orchard SaaS.</DescriptionBody>
    <PackageTags>OrchardCore;Lombiq;AspNetCore;CodeGeneration;ShapeTracing;Widgets</PackageTags>
    <RepositoryUrl>https://github.com/Lombiq/Helpful-Extensions</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Autoroute" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Contents" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Flows" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Html" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Lists" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Liquid" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Markdown" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.MetaWeblog.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Rules.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Workflows" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Lombiq.MSBuild.OrchardCore.Module.Sdk" Version="2.0.1" />
</Project>
